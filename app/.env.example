# Copy to .env for local development. Never commit .env.
# P2.6 §16 / P2.7 §13 — local development configuration.

# Core application
PORT=4177
DATABASE_URL=postgres://localhost:5432/devworkspace

# Worker (same codebase, separate process)
WORKER_POLL_INTERVAL_MS=1000

# DEV-ONLY authentication boundary (P2.7 §5).
# This is NOT the final authentication architecture. It maps an opaque
# request credential to a seeded principal id so the authorization boundary
# can be exercised end to end. Replaced wholesale in a later milestone.
DEV_AUTH_ENABLED=true

# Tests use a separate database.
TEST_DATABASE_URL=postgres://localhost:5432/devworkspace_test

# --- T3.3 external activity (GitHub) ----------------------------------------
# The repository whose activity this workspace tracks. Naming a repository is
# configuration; the activity itself is always read live from the GitHub API at
# request time and is never seeded, cached in the page, or replayed from a
# fixture.
GITHUB_REPOSITORY=devv0311/personal-dev-workspace

# OPTIONAL. Absent is a supported mode, not a broken one: a public repository is
# read anonymously (60 requests/hour) and the UI states which mode is in use. A
# token raises the limit and is required for a private repository. It is read by
# the server-side adapter only and never reaches the browser or any response —
# keep it in .env, which is git-ignored.
# GITHUB_TOKEN=

# How long a successful snapshot is reused before GitHub is re-read (ms).
# GITHUB_CACHE_TTL_MS=300000
