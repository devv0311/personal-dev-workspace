# Copy to .env for local development. Never commit .env.
# P2.6 §16 / P2.7 §13 — local development configuration.

# Core application
PORT=4177
DATABASE_URL=postgres://localhost:5432/devworkspace

# Worker (same codebase, separate process)
WORKER_POLL_INTERVAL_MS=1000

# DEV-ONLY authentication boundary (P2.7 §5).
# This is NOT the final authentication architecture. It maps an opaque
# request credential to a seeded principal id so the authorization boundary
# can be exercised end to end. Replaced wholesale in a later milestone.
DEV_AUTH_ENABLED=true

# Tests use a separate database.
TEST_DATABASE_URL=postgres://localhost:5432/devworkspace_test
