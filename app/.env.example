# Copy to .env for local development. Never commit .env.
# P2.6 §16 / P2.7 §13 — local development configuration.

# Core application
PORT=4177
DATABASE_URL=postgres://localhost:5432/devworkspace

# Worker (same codebase, separate process)
WORKER_POLL_INTERVAL_MS=1000

# DEV-ONLY authentication boundary (P2.7 §5).
# This is NOT the final authentication architecture. It maps an opaque
# request credential to a seeded principal id so the authorization boundary
# can be exercised end to end. Replaced wholesale in a later milestone.
DEV_AUTH_ENABLED=true

# Tests use a separate database.
TEST_DATABASE_URL=postgres://localhost:5432/devworkspace_test

# --- T3.3 external activity (GitHub) ----------------------------------------
# The repository whose activity this workspace tracks. Naming a repository is
# configuration; the activity itself is always read live from the GitHub API at
# request time and is never seeded, cached in the page, or replayed from a
# fixture.
GITHUB_REPOSITORY=devv0311/personal-dev-workspace

# OPTIONAL. Absent is a supported mode, not a broken one: a public repository is
# read anonymously (60 requests/hour) and the UI states which mode is in use. A
# token raises the limit and is required for a private repository. It is read by
# the server-side adapter only and never reaches the browser or any response —
# keep it in .env, which is git-ignored.
# GITHUB_TOKEN=

# How long a successful snapshot is reused before GitHub is re-read (ms).
# GITHUB_CACHE_TTL_MS=300000

# --- T3.3-CORRECTION: per-user mail accounts ---------------------------------
# Every value below is server-side only. No client id, no client secret and no
# token ever reaches the browser — the browser only ever receives the PROVIDER's
# own consent URL, which is public by design.

# REQUIRED to connect a mailbox. 32 bytes, hex- or base64-encoded, used to seal
# stored mail credentials at rest (AES-256-GCM). There is deliberately NO
# default: a deployment without a key cannot store a credential securely, so it
# refuses to connect one and the settings surface says exactly that rather than
# failing after the user has already given consent at the provider.
#   generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# MAIL_TOKEN_KEY=

# Public origin the provider redirects back to after consent. Must match the
# redirect URI registered with each provider. Defaults to http://localhost:PORT.
# MAIL_OAUTH_REDIRECT_BASE=http://localhost:4177

# OPTIONAL per provider. A provider without credentials is listed in the
# settings surface as unavailable WITH the reason, never as a button that fails
# after it is pressed. Scopes requested are read-only: this product triages
# inbound work, it does not send or modify mail.
# MAIL_GOOGLE_CLIENT_ID=
# MAIL_GOOGLE_CLIENT_SECRET=
# MAIL_MICROSOFT_CLIENT_ID=
# MAIL_MICROSOFT_CLIENT_SECRET=

# --- assistant model provider (optional) -------------------------------------
# Absent ⇒ the deterministic development stub answers. The stub is NOT a model:
# it reports no model tier and no effort level, so every option in a Skills
# card's configuration matrix is rendered unavailable and the pipeline refuses
# a request naming one. With a key present, the Anthropic adapter reports the
# tiers and effort levels it will genuinely send.
# ANTHROPIC_API_KEY=
# ASSISTANT_MODEL=claude-sonnet-5
